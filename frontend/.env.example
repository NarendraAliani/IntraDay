# frontend/.env.example
#
# Checkpoint 9: documents the client-visible Vite environment variables the
# frontend reads. Copy to `.env.local` (already gitignored) for local
# overrides — never commit a real `.env*` file.
#
# NOTE: every `VITE_*` variable is bundled into the built JS and shipped to
# the browser as plain text. Never put a secret, API key, or credential in
# a `VITE_*` variable. This app currently needs none.

# Base URL of the Django backend's HTTP API. Safe local dev default only —
# points at the Django dev server started by `manage.py runserver` on its
# default port. See docs/api/FRONTEND_API_CONSUMPTION.md.
VITE_API_BASE_URL=http://127.0.0.1:8000
