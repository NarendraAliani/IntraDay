# .env.example
#
# Repository root. Copy to `.env` for local development — docker-compose
# and manage.py both read `.env` via python-dotenv. `.env` is gitignored;
# this file (.env.example) contains ONLY placeholder variable names, never
# real values, and IS committed. See docs/architecture/TECHNOLOGY_MAPPING.md
# §12-13 for the full security and configuration model.

# --- Django ---
DJANGO_SETTINGS_MODULE=intraday.settings.development
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-for-any-non-development-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Trading safety (see src/intraday/settings/trading_mode.py) ---
# One of: RESEARCH | PAPER | LIVE. Never set LIVE outside production.
TRADING_MODE=RESEARCH

# --- PostgreSQL (system of record — see TECHNOLOGY_MAPPING.md §4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intraday
POSTGRES_USER=intraday
POSTGRES_PASSWORD=changeme

# --- Redis (cache / Channels layer / Celery broker+backend only —
#     never a system of record, see TECHNOLOGY_MAPPING.md §5) ---
REDIS_URL=redis://localhost:6379/0

# --- Dhan broker credentials (placeholders only — never commit real
#     values; not used until Checkpoint 8, present here only so the
#     TRADING_MODE=LIVE presence-check in settings/production.py has a
#     documented variable name to look for) ---
DHAN_API_KEY=
DHAN_ACCESS_TOKEN=

# --- Error tracking (optional, see TECHNOLOGY_MAPPING.md §11) ---
SENTRY_DSN=
