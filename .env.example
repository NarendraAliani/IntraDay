# .env.example
#
# Repository root. Copy to `.env` for local development — docker-compose
# and manage.py both read `.env` via python-dotenv. `.env` is gitignored;
# this file (.env.example) contains ONLY placeholder variable names, never
# real values, and IS committed. See docs/architecture/TECHNOLOGY_MAPPING.md
# §12-13 for the full security and configuration model.

# --- Django ---
DJANGO_SETTINGS_MODULE=intraday.settings.development
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-for-any-non-development-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Trading safety (see src/intraday/settings/trading_mode.py) ---
# One of: RESEARCH | PAPER | LIVE. Never set LIVE outside production.
TRADING_MODE=RESEARCH

# --- PostgreSQL (system of record — see TECHNOLOGY_MAPPING.md §4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intraday
POSTGRES_USER=intraday
POSTGRES_PASSWORD=changeme

# --- Redis (cache / Channels layer / Celery broker+backend only —
#     never a system of record, see TECHNOLOGY_MAPPING.md §5) ---
REDIS_URL=redis://localhost:6379/0

# --- Checkpoint 22: encryption-at-rest key for operational provider
#     credentials stored via the Settings UI (see
#     infrastructure/persistence/encryption.py and
#     docs/architecture/PROVIDER_CONNECTIVITY_ARCHITECTURE.md). Generate
#     a real value for any non-development use with:
#       poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#     Left empty here — base.py falls back to a development-only key
#     derived from DJANGO_SECRET_KEY when this is unset; production.py
#     refuses to boot without a real value. ---
SETTINGS_ENCRYPTION_KEY=

# --- Dhan broker credentials — BOOTSTRAP/FALLBACK ONLY (Checkpoint 22
#     §4-6): the Settings UI (Database) is the PRIMARY configuration
#     source; these env vars are used only when nothing has been
#     configured through the Settings UI yet. Field names match the
#     official DhanHQ v2 authentication scheme exactly
#     (https://dhanhq.co/docs/v2/authentication/) - `dhanClientId` and
#     `access-token` headers, never invented field names. Placeholders
#     only — never commit real values. ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Telegram bot notifications — bootstrap/fallback only, same
#     precedence as Dhan above (Checkpoint 22). Bot token from
#     @BotFather; channel/chat id is the destination for notifications.
#     Placeholders only — never commit real values. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Discord webhook notifications — bootstrap/fallback only, same
#     precedence as above (Checkpoint 22). The full webhook URL
#     (https://discord.com/api/webhooks/{id}/{token}) is itself the
#     credential — treat it as a secret. Placeholders only — never
#     commit a real value. ---
DISCORD_WEBHOOK_URL=

# --- Future communication provider (documented, NOT implemented -
#     Checkpoint 22 §18/§9 — do not add active integration code for
#     this until a dedicated future checkpoint authorizes it) ---
# WHATSAPP_* — reserved, intentionally absent.

# --- Error tracking (optional, see TECHNOLOGY_MAPPING.md §11) ---
SENTRY_DSN=
